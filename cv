#include <iostream>

using namespace std;

class GrafuriOrientate
{
private:
    int** amtrice; // adjacency matrix
    int n;         // number of vertices

public:
    GrafuriOrientate(int size);
    virtual ~GrafuriOrientate();

    void citesteGraf();           // function to read the graph
    void adaugaMuchie(int x, int y); // function to add an edge (margin)
    void afisMatrice();

    int getN() const { return n; }
    int** getMatrice() const { return amtrice; }
};

GrafuriOrientate::GrafuriOrientate(int size)
{
    n = size;
    amtrice = new int*[n];
    for (int i = 0; i < n; ++i)
    {
        amtrice[i] = new int[n];
        for (int j = 0; j < n; ++j)
            amtrice[i][j] = 0;
    }
}

GrafuriOrientate::~GrafuriOrientate()
{
    for (int i = 0; i < n; ++i)
        delete[] amtrice[i];
    delete[] amtrice;
}

void GrafuriOrientate::citesteGraf()
{
    cout << "Introduceti matricea de adiacenta:" << endl;
    for (int i = 0; i < n; ++i)
    {
        for (int j = 0; j < n; ++j)
        {
            int x;
            cin >> x;
            if (x)
                adaugaMuchie(i, j);
        }
    }
}

void GrafuriOrientate::adaugaMuchie(int x, int y)
{
    if (x >= 0 && x < n && y >= 0 && y < n)
        amtrice[x][y] = 1;
}

void GrafuriOrientate::afisMatrice()
{
    cout << "Matricea de adiacenta:" << endl;
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; ++j)
            cout << amtrice[i][j] << " ";
        cout << endl;
    }
}

// Clasa derivata Probleme
class Probleme : public GrafuriOrientate
{
public:
    Probleme(int size) : GrafuriOrientate(size) {}

    // Exemplu: verifica daca exista drum de la x la y (DFS)
    bool existaDrum(int x, int y)
    {
        int n = getN();
        int** mat = getMatrice();
        bool* viz = new bool[n]{false};
        bool found = dfs(x, y, mat, n, viz);
        delete[] viz;
        return found;
    }

    // Exemplu: afiseaza toate nodurile izolate
    void afiseazaNoduriIzolate()
    {
        int n = getN();
        int** mat = getMatrice();
        cout << "Noduri izolate: ";
        bool gasit = false;
        for (int i = 0; i < n; ++i)
        {
            bool izolat = true;
            for (int j = 0; j < n; ++j)
                if (mat[i][j] || mat[j][i])
                    izolat = false;
            if (izolat)
            {
                cout << i << " ";
                gasit = true;
            }
        }
        if (!gasit)
            cout << "Nu exista";
        cout << endl;
    }

private:
    bool dfs(int x, int y, int** mat, int n, bool* viz)
    {
        if (x == y) return true;
        viz[x] = true;
        for (int i = 0; i < n; ++i)
        {
            if (mat[x][i] && !viz[i])
                if (dfs(i, y, mat, n, viz))
                    return true;
        }
        return false;
    }
};



