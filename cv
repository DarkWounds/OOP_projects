#include <iostream>

using namespace std;

class GrafuriOrientate
{
private:
    int** amtrice; // adjacency matrix
    int n;         // number of vertices

public:
    GrafuriOrientate(int size);
    ~GrafuriOrientate();

    void citesteGraf();           // function to read the graph
    void adaugaMuchie(int x, int y); // function to add an edge (margin)
    void afisMatrice();
};

GrafuriOrientate::GrafuriOrientate(int size)
{
    n = size;
    amtrice = new int*[n];
    for (int i = 0; i < n; ++i)
    {
        amtrice[i] = new int[n];
        for (int j = 0; j < n; ++j)
            amtrice[i][j] = 0;
    }
}

GrafuriOrientate::~GrafuriOrientate()
{
    for (int i = 0; i < n; ++i)
        delete[] amtrice[i];
    delete[] amtrice;
}

void GrafuriOrientate::citesteGraf()
{
    cout << "Introduceti matricea de adiacenta:" << endl;
    for (int i = 0; i < n; ++i)
    {
        for (int j = 0; j < n; ++j)
        {
            int x;
            cin >> x;
            if (x)
                adaugaMuchie(i, j);
        }
    }
}

void GrafuriOrientate::adaugaMuchie(int x, int y)
{
    if (x >= 0 && x < n && y >= 0 && y < n)
        amtrice[x][y] = 1;
}

void GrafuriOrientate::afisMatrice()
{
    cout << "Matricea de adiacenta:" << endl;
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; ++j)
            cout << amtrice[i][j] << " ";
        cout << endl;
    }
}



